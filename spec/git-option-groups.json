        ],
        "checks": [
          {
            "id": "revision.count-after-oldest",
            "kind": "forbid",
            "origin": "git",
            "source": "Git 2.55.0 revision.c:handle_revision_opt/setup_revisions",
            "reason": "--max-count cannot follow --max-count-oldest.",
