      {
        "id": "diff.object-pickaxe-all",
        "kind": "conflicts",
        "origin": "git",
        "source": "Git 2.55.0 diff.c:diff_setup_done",
        "reason": "Object pickaxe cannot use --pickaxe-all.",
        "when": {
          "key": "find-object",
          "test": "present"
        },
        "others": [
